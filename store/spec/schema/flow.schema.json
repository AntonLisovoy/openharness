{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.autonomous.ai/dsh/spec/1/flow.schema.json",
  "title": "Orchestrator flow (.harness/flows/*.yaml), spec 1",
  "type": "object",
  "properties": {
    "spec": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "engine": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": "string",
            "maxLength": 32768
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "harness": {
            "type": "string",
            "minLength": 1,
            "maxLength": 129
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24000,
            "description": "Shell command, run in the task folder in its own process group. Exit 0 is success. Inputs are in HARNESS_INPUT_<NAME>; $inputs is not substituted here."
          },
          "outputs": {
            "type": "object",
            "properties": {
              "files": {
                "minItems": 1,
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\\\0]+$"
                }
              },
              "verdict": {
                "type": "string",
                "const": "ready"
              }
            },
            "required": [
              "files"
            ],
            "additionalProperties": false,
            "description": "Agent tasks: when the worker ends a turn and every glob matches a file in the task folder (and .harness/verdict.json says ready, if asked), the task finishes."
          },
          "timeout": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,5}[smh]$",
            "description": "Limit for one attempt, at most 24h. Shell steps default to 10m; agent tasks have no default."
          },
          "retry": {
            "type": "object",
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            },
            "required": [
              "max_attempts"
            ],
            "additionalProperties": false,
            "description": "Automatic retries: max_attempts is the number of attempts in all, the first attempt included. Without retry a failed task is not run again automatically."
          },
          "depends_on": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "description": "A shell step: run, without harness, prompt or outputs.",
            "required": [
              "id",
              "run"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "harness"
                  ]
                },
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "outputs"
                  ]
                }
              ]
            }
          },
          {
            "description": "An agent task: harness and prompt, without run.",
            "required": [
              "id",
              "harness",
              "prompt"
            ],
            "not": {
              "required": [
                "run"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "spec",
    "name",
    "tasks"
  ],
  "additionalProperties": false
}
